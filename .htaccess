# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php83" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler

DirectoryIndex index.php public/index.php index.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # Allow cPanel AutoSSL and Let's Encrypt validation (prevents nightly SSL cron conflicts)
    RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
    RewriteRule ^ - [L]

    # Prevent direct access to sensitive files and configs
    RewriteRule ^\.(env|git|editorconfig) - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|phpunit\.xml|deploy\.bat) - [F,L,NC]

    # If the request is for public folder directly, let it through
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # Serve static assets directly from /public/ if they exist
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all other requests to public/index.php
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
