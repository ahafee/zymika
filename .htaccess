<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and configs
    RewriteRule ^\.(env|git|editorconfig) - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|phpunit\.xml|deploy\.bat) - [F,L,NC]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
